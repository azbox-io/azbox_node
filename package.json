{
  "name": "azbox-node",
  "version": "0.2.0",
  "description": "Small Node.js / TypeScript client to fetch translations from your AZbox projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run clean && npm run build && node --test test/",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "azbox",
    "i18n",
    "localization",
    "translations",
    "keywords",
    "node"
  ],
  "author": "AZbox",
  "license": "MIT",
  "homepage": "https://azbox.io/docs/quickstart/node/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azbox-io/azbox_node.git"
  },
  "bugs": {
    "url": "https://github.com/azbox-io/azbox_node/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
